# Server-only Resend credential. Configure this in .env.local for development
# or in the deployment provider's server environment settings.
RESEND_API_KEY=<your-resend-api-key-here>
# Public site key used by the browser Turnstile widget.
VITE_TURNSTILE_SITE_KEY=<your-turnstile-site-key-here>
# Server-only Turnstile secret. Never prefix this with VITE_.
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key-here>
